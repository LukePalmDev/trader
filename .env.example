# Copia in .env nella root del repo (il file .env non va committato).
# python3 carica questo file all'avvio e non sovrascrive variabili già presenti.
# Sul server la stessa lista vive in /etc/trader/trader.env
# (vedi anche deploy/trader.env.example).

TRADER_DB_PATH=tracker.db
TRADER_OUTPUT_DIR=data
TRADER_VIEWER_HOST=127.0.0.1
TRADER_VIEWER_PORT=8080
TRADER_VIEWER_OPEN_BROWSER=false
TRADER_PLAYWRIGHT_CHANNEL=chromium

# Vuoto = il viewer genera un token di sessione. In produzione: openssl rand -hex 32
TRADER_API_TOKEN=

TRADER_TELEGRAM_ENABLED=false
TRADER_TELEGRAM_TOKEN=
TRADER_TELEGRAM_CHAT_ID=

# Classificazione a cascata (OpenRouter di default). Senza chiave i comandi AI escono con errore.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CASCADE_MODELS=openai/gpt-5-nano,openai/gpt-4.1-nano,openai/gpt-5.4-nano

# Fallback Anthropic dismesso. Lascialo false.
TRADER_ENABLE_LEGACY_ANTHROPIC=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Proxy egress opzionale (residenziale) per sorgenti che bloccano gli IP datacenter.
# TRADER_PROXY=http://utente:password@host:porta
